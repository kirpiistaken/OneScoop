    "settings.water_remind_smart_learning %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Routine wird gelernt: %1$lld von %2$lld Tagen. Bis dahin richten sich die Erinnerungen nach deinem Tagesziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning your routine: %1$lld of %2$lld days. Until then, reminders follow your daily goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendiendo tu rutina: %1$lld de %2$lld días. Mientras tanto, los recordatorios siguen tu objetivo diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprentissage de votre rythme : %1$lld jour(s) sur %2$lld. D’ici là, les rappels suivent votre objectif quotidien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto imparando la tua routine: %1$lld di %2$lld giorni. Fino ad allora i promemoria seguono l’obiettivo giornaliero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendendo sua rotina: %1$lld de %2$lld dias. Até lá, os lembretes seguem sua meta diária."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenin öğreniliyor: %1$lld/%2$lld gün. O zamana kadar günlük hedefine göre hatırlatır."
          }
        }
      }
    },
    "settings.water_remind_smart_ready": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop weiß jetzt, wann du normalerweise trinkst. Du wirst nur erinnert, wenn du deutlich hinter deiner eigenen Routine liegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop has learned when you usually drink. You only get a reminder when you're clearly behind your own routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop ya sabe cuándo sueles beber. Solo te avisa cuando vas claramente por detrás de tu propia rutina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop a appris quand vous buvez d’habitude. Vous n’êtes rappelé que si vous êtes nettement en retard sur votre propre rythme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop ha imparato quando bevi di solito. Ti avvisa solo quando sei chiaramente indietro rispetto alla tua routine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OneScoop já aprendeu quando você costuma beber. Você só recebe um lembrete quando está claramente atrás da sua própria rotina."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop genelde ne zaman su içtiğini öğrendi. Sadece kendi düzeninin belirgin gerisinde kaldığında hatırlatır."
          }
        }
      }
    },
