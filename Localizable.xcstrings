    "settings.loading_footer %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Noch %lld Ladetag. Eine so große Dosis wird meist auf mehrere Portionen über den Tag verteilt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Noch %lld Ladetage. Eine so große Dosis wird meist auf mehrere Portionen über den Tag verteilt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day of loading left. A dose this size is usually split into several servings across the day."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days of loading left. A dose this size is usually split into several servings across the day."
