    "settings.water_health_footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasser, das du hier einträgst, wird in Apple Health gespeichert, und Wasser aus anderen Apps in Health erscheint in OneScoop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water you log here is saved to Apple Health, and water from other apps in Health shows up in OneScoop."
