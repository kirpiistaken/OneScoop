    "settings.widget_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Home-Bildschirm gedrückt, tippe auf „Bearbeiten“, dann auf „Widget hinzufügen“ und wähle OneScoop. Du kannst die Dosis direkt im Widget eintragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press your home screen, tap Edit, then Add Widget and pick OneScoop. You can log the dose straight from the widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la pantalla de inicio, toca Editar, luego Añadir widget y elige OneScoop. Puedes registrar la dosis directamente desde el widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur l’écran d’accueil, touchez Modifier, puis Ajouter un widget et choisissez OneScoop. Vous pouvez noter la dose directement depuis le widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto sulla schermata Home, tocca Modifica, poi Aggiungi widget e scegli OneScoop. Puoi registrare la dose direttamente dal widget."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure a Tela de Início, toque em Editar, depois em Adicionar widget e escolha o OneScoop. Dá para registrar a dose direto pelo widget."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekranına uzun bas, Düzenle'ye, ardından Widget Ekle'ye dokun ve OneScoop'u seç. Dozu doğrudan widget'tan kaydedebilirsin."
          }
        }
      }
    },
