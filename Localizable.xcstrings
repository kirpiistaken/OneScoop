        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agua que registras aquí se guarda en Salud, y el agua de otras apps en Salud aparece en OneScoop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
