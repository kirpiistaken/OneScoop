        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il reste %lld jour de charge. Une dose de cette taille se prend généralement en plusieurs prises dans la journée."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il reste %lld jours de charge. Une dose de cette taille se prend généralement en plusieurs prises dans la journée."
