    "supply.empty_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag OneScoop, wie groß deine Dose ist. Jede eingetragene Dosis wird abgezogen, so weißt du immer, wie viele Tage dir bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell OneScoop how big your tub is. Every dose you log is subtracted, so you always know how many days you have left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a OneScoop de qué tamaño es tu bote. Cada dosis que registras se descuenta, así que siempre sabrás cuántos días te quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez à OneScoop la taille de votre pot. Chaque dose notée est déduite : vous savez toujours combien de jours il vous reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di’ a OneScoop quanto è grande il tuo barattolo. Ogni dose registrata viene sottratta, così sai sempre quanti giorni ti restano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga ao OneScoop o tamanho do seu pote. Cada dose registrada é descontada, então você sempre sabe quantos dias restam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop'a kutunun ne kadar büyük olduğunu söyle. Kaydettiğin her doz düşülür, böylece kaç günün kaldığını hep bilirsin."
          }
        }
      }
    },
