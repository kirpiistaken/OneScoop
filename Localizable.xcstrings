    "settings.icloud_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten bleiben nur auf diesem iPhone. Wenn du die App löschst, sind sie auch weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on this iPhone only. Deleting the app deletes it too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se quedan solo en este iPhone. Si borras la app, también se borran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent uniquement sur cet iPhone. Supprimer l’app les supprime aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano solo su questo iPhone. Se elimini l’app, vengono eliminati anche loro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam só neste iPhone. Se você apagar o app, eles também são apagados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerin yalnızca bu iPhone'da kalır. Uygulamayı silersen onlar da silinir."
          }
        }
      }
    },
    "settings.icloud_on": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Verlauf und deine Einstellungen liegen in deinem eigenen iCloud-Konto und sind wieder da, wenn du OneScoop neu installierst oder ein neues iPhone nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your history and settings are kept in your own iCloud account, so they come back if you reinstall OneScoop or move to a new iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historial y tus ajustes se guardan en tu propia cuenta de iCloud, así que vuelven si reinstalas OneScoop o cambias de iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre historique et vos réglages sont conservés dans votre propre compte iCloud : ils reviennent si vous réinstallez OneScoop ou changez d’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia e impostazioni restano nel tuo account iCloud, così tornano se reinstalli OneScoop o passi a un nuovo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu histórico e seus ajustes ficam na sua própria conta do iCloud e voltam se você reinstalar o OneScoop ou trocar de iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişin ve ayarların kendi iCloud hesabında tutulur; OneScoop'u yeniden yüklediğinde ya da yeni bir iPhone'a geçtiğinde geri gelir."
          }
        }
      }
    },
