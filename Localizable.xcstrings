    "onb.loading_summary %@ %lld %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld Tage lang täglich %1$@ g, danach ab Tag %4$lld %3$@ g. Eine so große Ladedosis wird meist über den Tag verteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ g daily for %2$lld days, then %3$@ g from day %4$lld on. A loading dose this size is usually split across the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ g al día durante %2$lld días y luego %3$@ g a partir del día %4$lld. Una dosis de carga así suele repartirse a lo largo del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ g par jour pendant %2$lld jours, puis %3$@ g à partir du jour %4$lld. Une dose de charge de cette taille se répartit généralement sur la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ g al giorno per %2$lld giorni, poi %3$@ g dal giorno %4$lld. Una dose di carico così si divide di solito nell’arco della giornata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ g por dia durante %2$lld dias e depois %3$@ g a partir do dia %4$lld. Uma dose de saturação desse tamanho costuma ser dividida ao longo do dia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld gün boyunca günde %1$@ g, %4$lld. günden itibaren %3$@ g. Bu büyüklükte bir yükleme dozu genelde güne yayılarak alınır."
          }
        }
      }
    },
