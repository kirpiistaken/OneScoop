    "settings.after_workout_footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Training in Apple Health landet und du noch kein Kreatin erfasst hast, erinnert dich OneScoop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a workout lands in Apple Health and you haven’t logged creatine yet, OneScoop reminds you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un entreno llega a Salud y aún no registraste la creatina, OneScoop te lo recuerda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une séance arrive dans Santé et que vous n’avez pas encore noté la créatine, OneScoop vous le rappelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un allenamento arriva in Salute e non hai ancora registrato la creatina, OneScoop te lo ricorda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um treino chega ao Saúde e você ainda não registrou a creatina, o OneScoop te lembra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
