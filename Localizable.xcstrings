    "settings.repeat_footer_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine weitere Erinnerung, falls du nach der ersten noch nichts eingetragen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get another nudge if you still haven't logged your dose after the first reminder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe otro aviso si después del primer recordatorio aún no has registrado tu dosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez un nouveau rappel si vous n’avez toujours pas noté votre dose après le premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un altro promemoria se dopo il primo non hai ancora registrato la dose."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba outro aviso se, depois do primeiro lembrete, você ainda não registrou a dose."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk hatırlatmadan sonra hâlâ dozunu kaydetmediysen bir kez daha hatırlatılırsın."
          }
        }
      }
    },
    "settings.repeat_footer_on %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %1$@ wirst du alle %2$@ erinnert, bis du die Dosis einträgst. Die Wiederholungen enden um Mitternacht und werden sofort gelöscht, wenn du auf Ja tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After %1$@, you'll be nudged every %2$@ until you log the dose. Repeats stop at midnight and are all cancelled the moment you tap Yes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de las %1$@, te avisaremos cada %2$@ hasta que registres la dosis. Los avisos se detienen a medianoche y se cancelan en cuanto tocas Sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après %1$@, vous serez relancé toutes les %2$@ jusqu’à ce que vous notiez la dose. Les rappels s’arrêtent à minuit et sont tous annulés dès que vous touchez Oui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo le %1$@, riceverai un promemoria ogni %2$@ finché non registri la dose. Le ripetizioni si fermano a mezzanotte e vengono annullate appena tocchi Sì."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois das %1$@, você será lembrado a cada %2$@ até registrar a dose. As repetições param à meia-noite e são canceladas assim que você toca em Sim."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sonrasında dozu kaydedene kadar her %2$@ bir hatırlatılırsın. Tekrarlar gece yarısı durur ve Evet'e dokunduğun anda hepsi iptal olur."
          }
        }
      }
    },
