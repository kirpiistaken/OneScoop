    "badges.rule_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur am selben Tag erfasste Tage zählen. Später im Kalender nachgetragene nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only days logged on the day count. Days added later from the calendar don’t."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuentan los días registrados ese mismo día. Los añadidos después desde el calendario, no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les jours notés le jour même comptent. Ceux ajoutés plus tard depuis le calendrier, non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contano solo i giorni registrati in giornata. Quelli aggiunti dopo dal calendario no."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só contam os dias registrados no próprio dia. Os adicionados depois pelo calendário, não."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece o gün girilen kayıtlar sayılır. Takvimden sonradan eklenen günler sayılmaz."
          }
        }
      }
    },
