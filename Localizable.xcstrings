    "settings.water_remind_simple_footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung in festen Abständen über den Tag. Sie hören auf, sobald du dein Ziel erreichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder at a fixed interval during your day. They stop once you reach your goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio a intervalos fijos durante tu día. Se detienen al alcanzar tu objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel à intervalle fixe pendant la journée. Ils s’arrêtent une fois l’objectif atteint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria a intervalli fissi durante la giornata. Si fermano quando raggiungi l’obiettivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete em intervalos fixos durante o dia. Eles param quando você atinge a meta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün içinde sabit aralıklarla hatırlatır. Hedefe ulaşınca susar."
          }
        }
      }
    },
