{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop liest Wasser aus Apple Health, damit Wasser aus anderen Apps zu deinem Tagesziel zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop reads water from Apple Health so water you log in other apps counts toward your daily goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop lee el agua de Salud para que el agua que registras en otras apps cuente para tu objetivo diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop lit l’eau dans Santé pour que l’eau notée dans d’autres apps compte dans votre objectif quotidien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop legge l’acqua da Salute così l’acqua registrata in altre app conta per il tuo obiettivo giornaliero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OneScoop lê a água do Saúde para que a água registrada em outros apps conte para sua meta diária."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop, diğer uygulamalarda girdiğin su da günlük hedefine sayılsın diye Apple Sağlık'tan su verisini okur."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop speichert das Wasser, das du einträgst, in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop saves the water you log to Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop guarda en Salud el agua que registras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop enregistre dans Santé l’eau que vous notez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop salva in Salute l’acqua che registri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OneScoop salva no Saúde a água que você registra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop, girdiğin suyu Apple Sağlık'a kaydeder."
          }
        }
      }
    }
  },
  "version": "1.0"
}