{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop liest Wasser aus Apple Health für dein Ziel, Trainings, um das Ziel an Trainingstagen zu erhöhen und dich danach ans Kreatin zu erinnern, und dein Gewicht für den Wasserrechner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop reads water from Apple Health so water you log in other apps counts toward your goal, reads workouts to raise your goal on training days and remind you about creatine after a workout, and reads your weight for the water calculator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop lee el agua de Salud para que cuente para tu objetivo, tus entrenamientos para subir el objetivo y recordarte la creatina después de entrenar, y tu peso para la calculadora de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop lit l’eau dans Santé pour votre objectif, vos séances pour augmenter l’objectif et vous rappeler la créatine après l’entraînement, et votre poids pour le calculateur d’eau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop legge l’acqua da Salute per il tuo obiettivo, gli allenamenti per alzarlo e ricordarti la creatina dopo l’allenamento, e il tuo peso per il calcolatore d’acqua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OneScoop lê a água do Saúde para sua meta, seus treinos para aumentar a meta e lembrar da creatina depois do treino, e seu peso para a calculadora de água."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop, diğer uygulamalarda girdiğin su da hedefine sayılsın diye Apple Sağlık'tan su verisini; antrenman günlerinde hedefini artırmak ve antrenmandan sonra kreatini hatırlatmak için antrenmanlarını; su hesaplayıcısı için de kilonu okur."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop speichert das Wasser, das du einträgst, in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop saves the water you log to Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop guarda en Salud el agua que registras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop enregistre dans Santé l’eau que vous notez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop salva in Salute l’acqua che registri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OneScoop salva no Saúde a água que você registra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneScoop, girdiğin suyu Apple Sağlık'a kaydeder."
          }
        }
      }
    }
  },
  "version": "1.0"
}